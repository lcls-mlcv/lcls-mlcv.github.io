---
layout: page
---
<p class="post-meta">
  {{ page.date | date: "%B %d, %Y" }}
  {% if page.speaker %}by {{ page.speaker }}{% endif %}
</p>

{% if page.img %}
  {% assign image_start = page.img | slice: 0 %}
  {% if image_start == "/" %}
    {% assign image_src = page.img %}
  {% else %}
    {% assign image_src = page.img | prepend: "/" %}
  {% endif %}
  <img class="page-hero" src="{{ image_src | relative_url }}" alt="{{ page.title | escape }}">
{% endif %}

{{ content }}

{% if page.video %}
  <h2>Recording</h2>
  <div class="video-frame">
    <iframe src="{{ page.video }}" title="{{ page.title | escape }}" allowfullscreen></iframe>
  </div>
  {% if page.passcode %}
    <p class="caption">Passcode: {{ page.passcode }}</p>
  {% endif %}
{% endif %}
