---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ site.title }}</h1>
    {% if page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article>
    {% if page.profile.image %}
      {% assign profile_src = page.profile.image | prepend: "/assets/img/" %}
      <div class="profile float-{{ page.profile.align | default: 'right' }}">
        <img
          class="img-fluid z-depth-1 {% if page.profile.image_circular %}rounded-circle{% else %}rounded{% endif %}"
          src="{{ profile_src | relative_url }}"
          alt="{{ page.profile.image | escape }}"
        >
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.news %}
      <h2><a href="{{ '/news/' | relative_url }}">news</a></h2>
      {% include news.liquid scrollable=true %}
    {% endif %}

    {% if page.selected_papers %}
      <h2><a href="{{ '/publications/' | relative_url }}">selected publications</a></h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      {% include social.liquid %}
    {% endif %}
  </article>
</div>
