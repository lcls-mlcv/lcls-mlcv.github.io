<div class="col mb-4">
  <a class="card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable horizontal-card">
      <div class="row no-gutters">
        {% if project.img %}
          {% assign image_start = project.img | slice: 0 %}
          {% if image_start == "/" %}
            {% assign image_src = project.img %}
          {% else %}
            {% assign image_src = project.img | prepend: "/" %}
          {% endif %}
          <div class="col-md-6">
            <img class="card-img" src="{{ image_src | relative_url }}" alt="{{ project.title | escape }} thumbnail">
          </div>
        {% endif %}
        <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ project.title }}</h3>
            {% if project.description %}
              <p class="card-text">{{ project.description }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
