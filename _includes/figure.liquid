<figure class="figure">
  {% if include.path %}
    {% assign figure_path_start = include.path | slice: 0 %}
    {% if include.path contains "://" or figure_path_start == "/" %}
      {% assign figure_src = include.path %}
    {% else %}
      {% assign figure_src = include.path | prepend: "/" %}
    {% endif %}
    <img
      class="{{ include.class | default: 'img-fluid rounded' }}"
      src="{{ figure_src | relative_url }}"
      alt="{{ include.alt | default: include.title | default: 'image' | escape }}"
      {% if include.width %}width="{{ include.width }}"{% endif %}
      {% if include.loading %}loading="{{ include.loading }}"{% endif %}
    >
  {% endif %}
  {% if include.caption %}
    <figcaption class="caption">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
