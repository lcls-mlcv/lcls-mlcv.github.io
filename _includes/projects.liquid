<div class="col mb-4">
  <a class="card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {% assign image_start = project.img | slice: 0 %}
        {% if image_start == "/" %}
          {% assign image_src = project.img %}
        {% else %}
          {% assign image_src = project.img | prepend: "/" %}
        {% endif %}
        <img class="card-img-top" src="{{ image_src | relative_url }}" alt="{{ project.title | escape }} thumbnail">
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        {% if project.description %}
          <p class="card-text">{{ project.description }}</p>
        {% endif %}
        {% if project.github %}
          <p class="github-icon"><a href="{{ project.github }}">Code Repository</a></p>
        {% endif %}
      </div>
    </div>
  </a>
</div>
