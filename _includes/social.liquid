<div class="social">
  <div class="contact-icons">
    {% if site.github_username %}
      <a href="https://github.com/{{ site.github_username }}" aria-label="GitHub" title="GitHub"><i class="fa-brands fa-github"></i></a>
    {% endif %}
    {% if site.bluesky_url %}
      <a href="https://bsky.app/profile/{{ site.bluesky_url }}" aria-label="Bluesky" title="Bluesky"><i class="fa-brands fa-bluesky"></i></a>
    {% endif %}
  </div>
</div>
