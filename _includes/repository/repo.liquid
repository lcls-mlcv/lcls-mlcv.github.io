{% assign repository = include.repository | default: repo %}
{% if repository %}
  {% assign repo_parts = repository | split: "/" %}
  {% assign repo_owner = repo_parts[0] %}
  {% assign repo_name = repo_parts[1] %}
  <div class="repo">
    <a href="https://github.com/{{ repository }}" aria-label="{{ repository }} GitHub repository">
      <img
        class="repo-img-light"
        src="https://github-readme-stats.vercel.app/api/pin/?username={{ repo_owner }}&amp;repo={{ repo_name }}&amp;theme={{ site.repo_theme_light }}&amp;show_owner=true"
        alt="{{ repository }}"
      >
      <img
        class="repo-img-dark"
        src="https://github-readme-stats.vercel.app/api/pin/?username={{ repo_owner }}&amp;repo={{ repo_name }}&amp;theme={{ site.repo_theme_dark }}&amp;show_owner=true"
        alt="{{ repository }}"
      >
    </a>
  </div>
{% endif %}
