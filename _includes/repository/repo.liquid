{% assign repo_url = include.repository | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}" class="repo-card-link" target="_blank" rel="noopener noreferrer">
    <div class="repo-card">
      <div class="repo-card-header">
        <span class="repo-card-icon"><i class="fa-brands fa-github"></i></span>
        <span class="repo-card-title">{{ repo_owner }}/{{ repo_name }}</span>
      </div>
      <div class="repo-card-footer">
        View on GitHub →
      </div>
    </div>
  </a>
</div>
