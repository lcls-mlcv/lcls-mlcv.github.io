<header>
  <nav class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}">
    <div class="container">
      <button class="navbar-toggler" type="button" aria-label="Toggle navigation" data-toggle-nav>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
      <div class="navbar-collapse" id="site-nav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item {% if page.url == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">About</a>
          </li>
          {% assign nav_pages = site.pages | where: "nav", true | sort: "nav_order" %}
          {% for nav_page in nav_pages %}
            <li class="nav-item {% if page.url == nav_page.url %}active{% endif %}">
              <a class="nav-link" href="{{ nav_page.url | relative_url }}">{{ nav_page.title }}</a>
            </li>
          {% endfor %}
          {% if site.enable_darkmode %}
            <li class="nav-item">
              <button class="theme-toggle nav-link" type="button" aria-label="Toggle dark mode" title="Toggle dark mode" data-theme-toggle>
                <i class="theme-toggle-dark fa-solid fa-moon" aria-hidden="true"></i>
                <i class="theme-toggle-light fa-solid fa-sun" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
